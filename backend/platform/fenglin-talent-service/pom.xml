<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.fenglin</groupId>
        <artifactId>fenglin-cloud</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>fenglin-talent-service</artifactId>
    <name>fenglin-talent-service</name>
    <description>丰麟云才（Talent）业务域服务：组织人事、招聘、入转调离、培训、活水、敬业度、OKR、创新</description>

    <dependencies>
        <dependency>
            <groupId>com.fenglin</groupId>
            <artifactId>fenglin-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fenglin</groupId>
            <artifactId>fenglin-starter-mybatis</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fenglin</groupId>
            <artifactId>fenglin-starter-observability</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fenglin</groupId>
            <artifactId>fenglin-common-security</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fenglin</groupId>
            <artifactId>fenglin-common-audit</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fenglin</groupId>
            <artifactId>fenglin-common-crypto</artifactId>
        </dependency>

        <dependency>
            <groupId>com.fenglin</groupId>
            <artifactId>fenglin-common-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.fenglin</groupId>
            <artifactId>fenglin-talent-migrations</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <!-- 内嵌 PostgreSQL 集成测试在 CI 容器/低内存终端下需要显式限制堆与元空间，避免 fork JVM 原生内存分配失败 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <argLine>-Xmx768m -XX:MaxMetaspaceSize=320m -XX:ReservedCodeCacheSize=128m
                        -Djdk.net.URLClassPath.disableClassPathURLCheck=true
                        -Djdk.attach.allowAttachSelf=true</argLine>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
