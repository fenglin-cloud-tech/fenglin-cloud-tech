<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.fenglin</groupId>
        <artifactId>fenglin-cloud</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>fenglin-report-service</artifactId>
    <name>fenglin-report-service</name>

    <properties>
        <poi.version>5.2.5</poi.version>
        <openpdf.version>1.3.30</openpdf.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.fenglin</groupId>
            <artifactId>fenglin-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fenglin</groupId>
            <artifactId>fenglin-starter-mybatis</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fenglin</groupId>
            <artifactId>fenglin-starter-observability</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fenglin</groupId>
            <artifactId>fenglin-common-security</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fenglin</groupId>
            <artifactId>fenglin-common-audit</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi-ooxml</artifactId>
            <version>${poi.version}</version>
        </dependency>
        <dependency>
            <groupId>com.github.librepdf</groupId>
            <artifactId>openpdf</artifactId>
            <version>${openpdf.version}</version>
        </dependency>

        <dependency>
            <groupId>com.fenglin</groupId>
            <artifactId>fenglin-common-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.fenglin</groupId>
            <artifactId>fenglin-hub-migrations</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
